# Copy to .env.local and fill in what you have. Every one of these is optional:
# the app runs without any of them, it just does less.

# Real songs: sung, produced, made by a music model rather than sketched in the
# browser. Get it from elevenlabs.io. A paid plan carries a commercial licence;
# the free tier does not, so tracks made on it cannot be released.
ELEVENLABS_API_KEY=

# The copilot, the writing help, song ideas and the trends scoring. Without it
# those screens say so instead of pretending.
ANTHROPIC_API_KEY=

# Accounts, and your songs following you between devices. Without these two the
# app signs you in on this device only and keeps your tracks in this browser.
# Set them up by running supabase/schema.sql in your project's SQL editor.
# The anon key is designed to be public — the policies in that file, not the
# key, decide what anyone can read or write. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key, from the same Settings -> API page. This one bypasses
# every row-level policy, which is exactly why the server needs it: it writes
# the generation and purchase rows that must not be writable by the person they
# bill. It has no NEXT_PUBLIC_ prefix on purpose — that prefix would ship it to
# every visitor's browser and hand them the whole database.
# Without it, usage is not metered and the free tier is effectively unlimited.
SUPABASE_SERVICE_ROLE_KEY=

# Taking payments. From dashboard.paystack.com -> Settings -> API Keys.
# Use the test key (sk_test_...) until you have run a payment end to end.
# Without it nothing can be charged, and the app says so rather than pretending
# a checkout exists.
PAYSTACK_SECRET_KEY=
