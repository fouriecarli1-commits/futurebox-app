*.tsbuildinfo

# Browser probes.
#
# The scripts are kept. They were ignored, and that was a mistake with a
# consequence: every check written in a session lived only on that session's
# disk and went with it, so the repository claimed a test suite it did not
# have and nobody after could re-run a single one of them. They are 124KB of
# plain text with no fixtures and no keys in them — the one string that looks
# like a key is spelled `sk_test_not_a_real_key`.
#
# The pages they mount live beside the code as *.probe.tsx and are only a page
# when PROBE=1, so a production build cannot see them. See .probe/README.md.
#
# Anything that is not a script still goes: recordings, downloads, fixtures.
.probe/*
!.probe/README.md
!.probe/*.mjs

# The click-through audit harness writes screenshots and logs here.
audit/*.png
audit/*.log

# Copied out of @opendaw/nam-wasm by scripts/nam-copy.mjs at build time.
public/nam/

# The pages a probe mounts while it runs.
#
# Each of these is copied from its `*.probe.tsx` neighbour when the probe
# starts and deleted when it stops, so it exists only for the minute or two
# the probe is running. That is long enough: a `git add -A` during a probe
# run committed `app/proboothprobe/page.tsx` to main on 22 September 2026.
# `check:probepages` regenerates this list from the probes themselves and
# fails if any of them is tracked.
app/blowup/page.tsx
app/buildon/page.tsx
app/collabroom/page.tsx
app/heard/page.tsx
app/mixprobe/page.tsx
app/probe-hint/page.tsx
app/probe-logomark/page.tsx
app/probe-sungwords/page.tsx
app/proboothprobe/page.tsx
app/safezoneprobe/page.tsx
app/sharesheet/page.tsx
app/singbooth/page.tsx
app/singcheck/page.tsx
app/singvoices/page.tsx
app/songform/page.tsx
app/songfull/page.tsx
app/songwindow/page.tsx
app/staff/page.tsx
app/videowords/page.tsx
